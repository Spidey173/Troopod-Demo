{% comment %}
  Section: Purelane Categories (#categories)
  Bundle category cards grid matching purelane-homepage.html.
{% endcomment %}

<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: 'Bundle categories' }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: 'Find the right bundle for you' }}</h2>
    </div>
    <div class="cats">
      {%- for block in section.blocks -%}
        <a class="glass cat rv {{ block.settings.delay_class }}" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            <span class="pimg {{ block.settings.pimg_class | default: 'p-kitchen' }}" role="img" aria-label="{{ block.settings.title | escape }}"></span>
          </span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.subtitle }}</p>
          </span>
        </a>
      {%- else -%}
        <a class="glass cat rv" href="#combos"><span class="ph"><span class="pimg p-kitchen" role="img" aria-label="Kitchen bundle"></span></span><span class="txt"><h4>Kitchen bundle</h4><p>Grease, dishes &amp; more</p></span></a>
        <a class="glass cat rv rv-d1" href="#combos"><span class="ph"><span class="pimg p-toilet" role="img" aria-label="Bathroom bundle"></span></span><span class="txt"><h4>Bathroom bundle</h4><p>Deep clean &amp; disinfect</p></span></a>
        <a class="glass cat rv rv-d2" href="#combos"><span class="ph"><span class="pimg p-laundry" role="img" aria-label="Laundry bundle"></span></span><span class="txt"><h4>Laundry bundle</h4><p>Softer, fresher wash</p></span></a>
        <a class="glass cat rv rv-d3" href="#combos"><span class="ph"><span class="pimg p-tap" role="img" aria-label="Hard water bundle"></span></span><span class="txt"><h4>Hard water bundle</h4><p>Melt away limescale</p></span></a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Category Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "text",
          "id": "pimg_class",
          "label": "CSS Bottle Art Class (p-kitchen, p-toilet, p-laundry, p-tap)",
          "default": "p-kitchen"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        },
        {
          "type": "text",
          "id": "delay_class",
          "label": "Animation Delay Class (rv-d1, rv-d2, rv-d3)",
          "default": "rv-d1"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Categories"
    }
  ]
}
{% endschema %}
