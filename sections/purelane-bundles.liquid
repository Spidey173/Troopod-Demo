      "label": "Subheading Description",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Bundle Tier",
      "settings": [
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Shopify Product (optional)"
        },
        {
          "type": "text",
          "id": "tag_text",
          "label": "Tag Label",
          "default": "Starter"
        },
        {
          "type": "number",
          "id": "qty",
          "label": "Product Quantity",
          "default": 3
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_price",
          "label": "Compare Price",
          "default": "₹897"
        },
        {
          "type": "text",
          "id": "per_product_text",
          "label": "Unit Price Text",
          "default": "Flat ₹166 per product"
        },
        {
          "type": "text",
          "id": "feature1",
          "label": "Feature Line 1",
          "default": "Pick any three products"
        },
        {
          "type": "text",
          "id": "feature2",
          "label": "Feature Line 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "feature3",
          "label": "Feature Line 3",
          "default": "Covers kitchen and laundry"
        },
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Best Tier / Most Popular Highlight",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Bundles Grid",
      "blocks": [
        {
          "type": "tier",
          "settings": {
            "tag_text": "Starter",
            "qty": 2,
            "price": "₹349",
            "compare_price": "₹598",
            "per_product_text": "Flat ₹174 per product",
            "feature1": "Pick any two products",
            "feature2": "Free shipping across India",
            "feature3": "",
            "is_best": false
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_text": "Most popular",
            "qty": 3,
            "price": "₹499",
            "compare_price": "₹897",
            "per_product_text": "Flat ₹166 per product",
            "feature1": "Pick any three products",
            "feature2": "Covers kitchen and laundry",
            "feature3": "Free shipping across India",
            "is_best": true
          }
        },
        {
          "type": "tier",
          "settings": {
            "tag_text": "Whole home",
            "qty": 5,
            "price": "₹799",
            "compare_price": "₹1495",
            "per_product_text": "Flat ₹160 per product",
            "feature1": "Pick any five products",
            "feature2": "Every room in one order",
            "feature3": "Free shipping across India",
