<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% render 'meta-tags' %}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    {% render 'css-variables' %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ content_for_header }}

    {{ 'purelane.css' | asset_url | stylesheet_tag }}
  </head>

  <body class="purelane-wrapper">
    {% render 'purelane-water-bg' %}

    {% section 'purelane-ticker' %}
    {% sections 'header-group' %}

    <!-- Fixed Desktop Progress Rail -->
    <nav class="rail" aria-label="Section progress">
      <a href="#top" class="on" aria-label="Hero"></a>
      <a href="#reviews" aria-label="Reviews"></a>
      <a href="#ingredients" aria-label="Ingredients"></a>
      <a href="#how" aria-label="How it works"></a>
      <a href="#proof" aria-label="Proof"></a>
      <a href="#bundles" aria-label="Bundles"></a>
      <a href="#shop" aria-label="Shop"></a>
    </nav>

    <main id="top" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <!-- Mobile Sticky Bottom CTA -->
    <div class="sticky" aria-label="Quick bundle offer">
      <span class="lbl">
        <b>Pick any 3, pay ₹499</b>
        <span>Free shipping, always</span>
      </span>
      <a class="btn btn-primary btn-sm" href="#bundles">Build bundle</a>
    <!-- Toast Notification -->
    <div id="purelaneToast" class="purelane-toast glass-2" aria-live="polite">
      <span>Added to cart ✓</span>
    </div>

    <!-- DailyDrop Floating Bottom Cart Bar -->
    <div class="dailydrop-cart-bar glass-2" id="dailydropCartBar" aria-label="Cart summary" {% if cart.item_count == 0 %}style="display:none;"{% endif %}>
      <div class="dd-cart-info">
        <span class="dd-bag">🛍️</span>
        <div class="dd-details">
          <strong id="ddItemCount">{{ cart.item_count }} {% if cart.item_count == 1 %}item{% else %}items{% endif %}</strong>
          <span id="ddTotalPrice">{{ cart.total_price | money }}</span>
        </div>
      </div>
      <button type="button" class="btn btn-primary btn-sm dd-view-cart-btn" id="ddOpenCart">
        View Cart
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      </button>
    </div>

    <!-- Purelane Cart Drawer -->
    {% render 'purelane-cart-drawer' %}

    <script src="{{ 'purelane.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
